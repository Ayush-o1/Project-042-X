# Optional — only needed if you changed the backend port, or are pointing
# at a deployed backend (e.g. https://your-backend.onrender.com/api/v1).
# Defaults to http://localhost:5001/api/v1 when unset.
VITE_API_URL=http://localhost:5001/api/v1

# Optional — cosmetic only. Set to "true" on a public demo deployment so
# the UI's copy only ever mentions GitHub URLs, matching a backend running
# with PUBLIC_DEMO_MODE=true (which rejects local filesystem paths).
# VITE_PUBLIC_DEMO_MODE=true
