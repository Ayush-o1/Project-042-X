# Optional — only needed if you changed the backend port, or are pointing
# at a deployed backend (e.g. https://your-backend.onrender.com/api/v1).
# Defaults to http://localhost:5001/api/v1 when unset.
VITE_API_URL=http://localhost:5001/api/v1

# Optional — cosmetic only. Production builds already default this on, so
# the UI's copy only ever mentions GitHub URLs there. Set to "false" to
# show local-path copy in a production build (e.g. local `npm run preview`
# testing), or "true" to force it on during `npm run dev`.
# VITE_PUBLIC_DEMO_MODE=false
