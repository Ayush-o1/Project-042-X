# ── Backend (backend/.env) ───────────────────────────────────────────
# All values are optional; these are the defaults for local development.
PORT=5001
# The backend binds to loopback only. Do not expose it to the network:
# it reads local files on behalf of the frontend.
HOST=127.0.0.1
# Comma-separated CORS allowlist. Defaults to any localhost/127.0.0.1 port.
# ALLOWED_ORIGINS=http://localhost:5173

# ── Public demo deployment only (e.g. Render) — leave unset locally ───
# Set to "true" to run as a public demo backend: disables the localhost-only
# Host guard (meaningless behind a public hostname), and disables local
# filesystem-path analysis entirely — a public deployment only analyzes
# public GitHub repository URLs, never a path on the server's own disk.
# PUBLIC_DEMO_MODE=true

# Number of commits to fetch when cloning a GitHub URL for analysis.
# CLONE_DEPTH=500
# Hard timeout (ms) on the clone step.
# CLONE_TIMEOUT_MS=45000
# Reject (and delete) a clone once its on-disk size exceeds this, in MB.
# MAX_CLONE_SIZE_MB=300
# Max POST /analyze requests per IP per 15-minute window.
# ANALYZE_RATE_LIMIT=30

# ── Frontend (frontend/.env) ─────────────────────────────────────────
# Optional; defaults to http://localhost:5001/api/v1.
VITE_API_URL=http://localhost:5001/api/v1
